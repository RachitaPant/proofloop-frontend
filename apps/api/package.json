{
  "name": "@proofloop/api",
  "version": "1.0.0",
  "private": true,
  "description": "ProofLoop REST API (Express + MongoDB), deployable on Vercel or any Node host",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@proofloop/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
