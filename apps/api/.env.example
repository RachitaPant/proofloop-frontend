# MongoDB Configuration — point this at the SAME cluster/database the
# Spring Boot backend uses if you want the two to be interchangeable.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=Cluster1
MONGODB_DATABASE=proofloop

# JWT Configuration — must match the Spring Boot backend's jwt.secret if you
# want tokens issued by one backend to be valid on the other.
# Must be at least 32 characters — the server refuses to sign tokens otherwise.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRATION_MS=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.vercel.app

# Server Port (Render sets this automatically)
PORT=8080

# "production" disables the demo-data seeder, mirroring Spring's @Profile("!prod")
NODE_ENV=development

# Required on Vercel for the SLA cron hook (any long random string)
CRON_SECRET=change-me

# Max login/register attempts per IP per 15 minutes (per serverless instance)
AUTH_RATE_LIMIT=20
