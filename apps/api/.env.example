# MongoDB (Atlas connection string, or mongodb://localhost:27017 for a local server)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=Cluster1
MONGODB_DATABASE=proofloop

# Must be at least 32 characters; the server refuses to sign tokens otherwise.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Lifetime of the bearer token returned to API clients (Postman, scripts)
JWT_EXPIRATION_MS=86400000
# Browser sessions: access cookie lifetime and rotating refresh cookie lifetime
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated web app origins. Used for CORS and for the CSRF check on
# cookie-authenticated writes. "*" matches within one domain label, e.g.
# https://proofloop-frontend-*-rachitapants-projects.vercel.app for previews.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Port for the long-running server (ignored on Vercel)
PORT=8080

# "production" disables the demo-data seeder
NODE_ENV=development

# Required on Vercel for the SLA cron hook (any long random string)
CRON_SECRET=change-me

# Max login/register attempts per IP per 15 minutes (per serverless instance)
AUTH_RATE_LIMIT=20

# AI features (optional). Works with any OpenAI-compatible chat API. Without
# AI_API_KEY the AI buttons are hidden and the AI endpoints return 503.
#
# Free option (recommended): Groq. Create a key at https://console.groq.com/keys
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
# Optional: reasoning effort for reasoning models like gpt-oss (low is fastest)
AI_REASONING_EFFORT=low
# Optional: set to "object" for models/providers without JSON-schema output
# AI_JSON_MODE=object
# Spend/abuse caps: drafts per user per hour, and across all users per day
AI_REQUESTS_PER_HOUR=10
AI_DAILY_CAP=200

# Invite emails (optional). Without these, inviting still works: the admin gets
# a link to share. Where the web app lives, for links inside emails:
APP_URL=http://localhost:3000
# smtp | resend | console | none. Default: inferred from the credentials below,
# else console (prints the email) in development and none in production.
MAIL_PROVIDER=console
# SMTP, e.g. Gmail with an app password (needs 2-Step Verification). Delivers
# to anyone, no domain needed:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-character-app-password
# MAIL_FROM="ProofLoop <you@gmail.com>"
# Resend: needs a verified domain to email anyone but your own account
# RESEND_API_KEY=
# MAIL_FROM="ProofLoop <invites@your-domain.com>"
# Invites one admin can send per hour (per serverless instance)
INVITE_RATE_LIMIT=30
